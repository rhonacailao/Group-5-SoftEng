PORT=3000
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Where the React app runs (used for CORS and for the links in emails)
FRONTEND_URL=http://localhost:5173

# Login session length in hours, and password hashing strength (12 is a good default)
SESSION_HOURS=8
BCRYPT_ROUNDS=12

# Email. Leave SMTP_HOST empty while developing: emails are printed in the terminal instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="HOPE ERP <no-reply@example.com>"
